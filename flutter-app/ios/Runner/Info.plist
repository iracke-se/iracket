<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>iRacket</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>iRacket</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- Export compliance: app only uses standard exempt encryption (HTTPS/TLS),
		     no custom or proprietary crypto. Declaring this stops App Store Connect
		     from asking about export compliance on every build. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- Media capture permissions. Required because the WebView exposes file
		     inputs (e.g. profile photo upload) that can open the camera or photo
		     library. Without these usage-description strings iOS terminates the app
		     the moment the picker is invoked (App Store rejection 2.1a — crash on
		     tapping Camera). -->
		<key>NSCameraUsageDescription</key>
		<string>iRacket needs access to your camera so you can take and upload a profile photo.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>iRacket needs access to your photo library so you can choose and upload a profile photo.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>iRacket needs permission to save photos to your library.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>iRacket needs microphone access when you capture video to upload.</string>
	</dict>
</plist>
